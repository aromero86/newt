{
  // newt-react-ui: React components, for the browser. With the DOM and JSX; apart
  // from newt's own project, which has neither.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["bun"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["packages/newt-react-ui/**/*.ts", "packages/newt-react-ui/**/*.tsx"],
  "exclude": ["**/node_modules"]
}
