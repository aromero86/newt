{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.landing.tsbuildinfo",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@newt/ui/*": [
        "./src/libs/ui/*"
      ]
    }
  },
  "include": [
    "src/landing/**/*.ts",
    "src/landing/**/*.tsx",
    "src/libs/ui/**/*.ts",
    "src/libs/ui/**/*.tsx"
  ]
}
