{
  // The framework, newt, and its tests, on Bun: as it is, with no application's
  // additions to its types. No DOM.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": { "newt/*": ["./packages/newt/*/index.ts"] }
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["**/node_modules"]
}
