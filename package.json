{
  "name": "newt-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test",
    "lint": "eslint",
    "docs:dev": "vitepress dev web --port 5180",
    "docs:build": "vitepress build web",
    "cooper": "bun run cooper/scripts/dev.ts --watch",
    "cooper:seed": "bun run cooper/scripts/seed.ts",
    "cooper:migrations": "bun run cooper/scripts/migrations.ts",
    "cooper:build": "bun cooper/scripts/build.ts",
    "cooper:replicas": "bun run cooper/scripts/replicas.ts",
    "monitor": "bun --watch packages/newt-monitor/scripts/dev.ts",
    "monitor:build": "bun packages/newt-monitor/scripts/build.ts",
    "ui": "bun packages/newt-react-ui/gallery/serve.ts",
    "release:version": "bun scripts/version.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@preact/signals-core": "1.14.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "kysely": "0.29.6",
    "lucide-react": "1.48.0",
    "newt-kit": "workspace:*",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/bowlby-one": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "eslint": "10.12.0",
    "mermaid": "11.17.2",
    "newt-kit-eslint": "workspace:*",
    "newt-kit-monitor": "workspace:*",
    "newt-kit-react": "workspace:*",
    "newt-kit-react-ui": "workspace:*",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vitepress": "1.6.4"
  }
}
