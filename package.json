{
  "name": "newt-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test",
    "lint": "eslint",
    "docs:dev": "vitepress dev web --port 5180",
    "docs:build": "vitepress build web",
    "docs:check": "bun web/scripts/check-tutorial.ts"
  },
  "dependencies": {
    "newt": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "eslint": "10.12.0",
    "newt-eslint": "workspace:*",
    "newt-graph": "workspace:*",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitepress": "1.6.4"
  }
}
