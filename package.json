{
  "name": "newt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:backend": "bun --watch src/backend/index.ts",
    "dev:frontend": "vite src/frontend",
    "dev:landing": "astro dev --root src/landing",
    "build:frontend": "vite build src/frontend",
    "build:landing": "astro build --root src/landing",
    "typecheck": "tsc -b",
    "lint": "eslint",
    "test": "bun test src",
    "migrate:up": "bun run scripts/migrate.ts up",
    "migrate:down": "bun run scripts/migrate.ts down",
    "migrate:status": "bun run scripts/migrate.ts status",
    "seed:env": "bun run scripts/seed-env.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@preact/signals-core": "1.14.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.1",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "nodemailer": "10.0.10",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@astrojs/react": "7.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "astro": "7.3.8",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
