{
  "name": "newt-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test",
    "lint": "eslint",
    "docs:dev": "vitepress dev web --port 5180",
    "docs:build": "vitepress build web",
    "cooper": "bun run cooper/scripts/dev.ts --watch",
    "cooper:seed": "bun run cooper/scripts/seed.ts",
    "cooper:build": "vite build cooper/frontend/auth && vite build cooper/frontend/boards && vite build cooper/frontend/backoffice"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@preact/signals-core": "1.14.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "kysely": "0.29.6",
    "lucide-react": "1.48.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "newt-eslint": "workspace:*",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitepress": "1.6.4"
  }
}
