{
  "name": "newt-kit-eslint",
  "version": "0.1.0",
  "description": "The lint of an application built with newt: every module made of the same files, reaching others only through what they offer, and writing only through its repository.",
  "license": "MIT",
  "author": "Angel Romero",
  "homepage": "https://github.com/aromero86/newt/tree/main/packages/newt-eslint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aromero86/newt.git",
    "directory": "packages/newt-eslint"
  },
  "bugs": "https://github.com/aromero86/newt/issues",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "newt",
    "architecture"
  ],
  "files": [
    "index.js",
    "paths.js",
    "rules",
    "!**/*.test.ts",
    "!**/*.test.js",
    "!**/*.test.tsx",
    "!tsconfig.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.js"
  },
  "dependencies": {
    "typescript-eslint": "8.71.1"
  },
  "peerDependencies": {
    "eslint": "10.12.0"
  },
  "devDependencies": {
    "eslint": "10.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
