{
  "name": "newt-react-ui",
  "version": "0.0.0",
  "description": "The components of a React frontend of a newt application, and the lint that keeps an app from restyling them: pages compose them, an app's own components wrap them, and nothing else styles.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./theme.css": "./styles/theme.css",
    "./lint": "./lint/index.js",
    "./*": "./components/*/index.ts"
  },
  "peerDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "eslint": "^10.12.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  }
}
