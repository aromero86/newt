{
  "name": "@newt-kit/react-ui",
  "version": "0.1.1",
  "description": "The components of a React frontend of a newt application, and the lint that keeps an app from restyling them: pages compose them, an app's own components wrap them, and nothing else styles.",
  "license": "MIT",
  "author": "Angel Romero",
  "homepage": "https://aromero86.github.io/newt/manual/30-frontends",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aromero86/newt.git",
    "directory": "packages/newt-react-ui"
  },
  "bugs": "https://github.com/aromero86/newt/issues",
  "keywords": [
    "react",
    "newt",
    "components",
    "tailwind",
    "design-system"
  ],
  "files": [
    "components",
    "internal",
    "lint",
    "skills",
    "styles",
    "tokens.ts",
    "AGENTS.md",
    "!**/*.test.ts",
    "!**/*.test.js",
    "!**/*.test.tsx",
    "!tsconfig.json"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./theme.css": "./styles/theme.css",
    "./lint": "./lint/index.js",
    "./*": "./components/*/index.ts"
  },
  "newt": {
    "agents": "AGENTS.md",
    "skills": [
      "skills/newt-react-ui"
    ]
  },
  "peerDependencies": {
    "@newt-kit/eslint": "^0.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "eslint": "^10.12.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "@newt-kit/eslint": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
