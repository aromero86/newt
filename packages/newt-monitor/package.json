{
  "name": "@newt-kit/monitor",
  "version": "0.1.0",
  "description": "Watches newt applications: what each one is made of, read from it as it runs, never from its data. A newt application itself.",
  "license": "MIT",
  "author": "Angel Romero",
  "homepage": "https://github.com/aromero86/newt/tree/main/packages/newt-monitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aromero86/newt.git",
    "directory": "packages/newt-monitor"
  },
  "bugs": "https://github.com/aromero86/newt/issues",
  "keywords": [
    "bun",
    "monitoring",
    "observability",
    "traces",
    "newt",
    "mcp"
  ],
  "files": [
    "backend",
    "dist/frontend",
    "!**/*.test.ts",
    "!**/*.test.js",
    "!**/*.test.tsx",
    "!**/fixtures/**",
    "!tsconfig.json"
  ],
  "type": "module",
  "scripts": {
