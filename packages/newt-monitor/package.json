    "prepack": "bun scripts/build.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@newt-kit/newt": "workspace:*",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@preact/signals-core": "1.14.4",
    "bun-plugin-tailwind": "0.1.2",
    "lucide-react": "1.48.0",
    "@newt-kit/react": "workspace:*",
    "@newt-kit/react-ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "newt-monitor": "./backend/index.ts"
  }
}
