{
  "name": "@newt-kit/newt",
  "version": "0.1.1",
  "description": "A backend framework for Bun: modules, entities, use cases, domain events with a transactional outbox, scopes, and stores to keep them in.",
  "license": "MIT",
  "author": "Angel Romero",
  "homepage": "https://aromero86.github.io/newt/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aromero86/newt.git",
    "directory": "packages/newt"
  },
  "bugs": "https://github.com/aromero86/newt/issues",
  "keywords": [
    "bun",
    "framework",
    "backend",
    "ddd",
    "bounded-contexts",
    "use-cases",
    "domain-events",
    "outbox",
    "typescript"
  ],
  "files": [
    "**/*.ts",
    "**/migrations/**/*.sql",
    "AGENTS.md",
    "!**/*.test.ts",
    "!**/*.test.js",
    "!**/*.test.tsx",
    "!**/fixtures/**",
    "!tsconfig.json"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "newt": "./cli/newt.ts"
  },
  "exports": {
    "./core": "./core/index.ts",
    "./contract": "./contract/index.ts",
    "./port-store": "./port-store/index.ts",
    "./port-store/contract": "./port-store/contract/index.ts",
    "./port-outbox": "./port-outbox/index.ts",
    "./port-analytics": "./port-analytics/index.ts",
    "./port-analytics/contract": "./port-analytics/contract/index.ts",
    "./port-rate-limit": "./port-rate-limit/index.ts",
    "./port-rate-limit/contract": "./port-rate-limit/contract/index.ts",
    "./repository": "./repository/index.ts",
    "./runtime": "./runtime/index.ts",
    "./sql": "./sql/index.ts",
    "./adapter-sqlite": "./adapter-sqlite/index.ts",
    "./adapter-postgres": "./adapter-postgres/index.ts",
    "./adapter-mysql": "./adapter-mysql/index.ts",
    "./adapter-files": "./adapter-files/index.ts",
    "./adapter-redis": "./adapter-redis/index.ts",
    "./kysely": "./kysely/index.ts",
    "./http": "./http/index.ts",
    "./application": "./application/index.ts",
    "./otel": "./otel/index.ts",
    "./monitor": "./monitor/index.ts",
    "./testing": "./testing/index.ts",
    "./adapter-duckdb": "./adapter-duckdb/index.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "peerDependencies": {
    "zod": "^4.3.6",
    "kysely": "^0.29.6",
    "@duckdb/node-api": "^1.5.6-r.1"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "kysely": "0.29.6",
    "zod": "4.3.6"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "@duckdb/node-api": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
