{
  // The whole repository, as three projects: what runs on the server (newt and cooper's
  // backend), what runs in the browser (cooper's frontends and their libraries), and
  // the tools around them (scripts, Vite's configs). `bun check` follows the references.
  // The paths are here too because Bun and Vite resolve imports with this file.
  "compilerOptions": {
    "paths": {
      "newt/*": ["./packages/newt/*/index.ts"],
      "@cooper/ui/*": ["./cooper/libs/ui/*"],
      "@cooper/api/*": ["./cooper/libs/api/*"]
    }
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.backend.json" },
    { "path": "./tsconfig.frontend.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
