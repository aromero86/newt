{
  // newt-graph: a tool that reads an application (on Bun) and the page that draws it
  // (in a browser, with the DOM). Apart from newt's own project, which has no DOM.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["packages/newt-graph/**/*.ts"],
  "exclude": ["**/node_modules"]
}
