{
  // What of newt-monitor runs in the browser: its frontend, with the contracts of its
  // modules (their *.schema.ts) it shares with the backend.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["bun"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "packages/newt-monitor/frontend/**/*.ts",
    "packages/newt-monitor/frontend/**/*.tsx",
    "packages/newt-monitor/src/contexts/*/modules/*/*.schema.ts"
  ],
  "exclude": ["**/node_modules"]
}
